{
  "version": 1,
  "sdk_version": "0.20.0",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://spwvsrsfbokxghiprgvm.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "skillforge-mcp",
      "version": "0.1.0",
      "title": "SkillForge"
    },
    "tools": [
      {
        "name": "get_my_profile",
        "title": "Get my profile",
        "description": "Return the signed-in SkillForge user's profile (name, email, role, company, team).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "list_my_assignments",
        "title": "List my assignments",
        "description": "List training courses assigned to the signed-in user, with due date, status, and course details. Optionally filter by status.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "status": {
              "description": "Filter by assignment status.",
              "type": "string",
              "enum": [
                "not_started",
                "in_progress",
                "complete"
              ]
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "list_company_courses",
        "title": "List company courses",
        "description": "List training courses available in the signed-in user's company. Optionally filter by category or a text search on the title.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "category": {
              "description": "Exact category match.",
              "type": "string"
            },
            "search": {
              "description": "Case-insensitive substring match on title.",
              "type": "string"
            }
          }
        },
        "outputSchema": null
      }
    ]
  }
}
